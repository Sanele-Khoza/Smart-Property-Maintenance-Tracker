# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spmt
DB_USER=spmt_user
DB_PASSWORD=spmt_pass

#gmail alerts
GMAIL_USER=youraccount@gmail.com
 GMAIL_APP_PASSWORD=the 16-char password from
ADMIN_ALERT_EMAIL= whoever should get the alert


# JWT
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# AWS (set AWS_ENABLED=true to use cloud services)
AWS_ENABLED=false
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comprehend
AWS_COMPREHEND_ENDPOINT_ARN=

# Rekognition (not available in af-south-1, uses eu-west-1)
AWS_REKOGNITION_REGION=eu-west-1

# S3
AWS_S3_BUCKET_IMAGES=spmt-ticket-images-dev
AWS_S3_BUCKET_REPORTS=spmt-reports-dev
S3_PRESIGNED_URL_TTL_IMAGES_SECONDS=900
S3_PRESIGNED_URL_TTL_REPORTS_SECONDS=86400

# SNS
AWS_SNS_SMS_SENDER_ID=SPMT
AWS_SNS_PLATFORM_APP_ARN_IOS=
AWS_SNS_PLATFORM_APP_ARN_ANDROID=

# SES
AWS_SES_FROM_ADDRESS=noreply@spmt.co.za
AWS_SES_CONFIGURATION_SET=

# Gmail SMTP (used as fallback / when AWS_ENABLED=false)
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=youraccount@gmail.com

# Who receives the "new tenant registered" alert
ADMIN_ALERT_EMAIL=admin@yourcompany.com

# Secrets Manager (production only)
AWS_SECRETS_JWT_NAME=SPMT_JWT_SECRET
AWS_SECRETS_DB_NAME=SPMT_DB_URL

# AI thresholds
AI_TEXT_CONFIDENCE_THRESHOLD=0.60
AI_EMERGENCY_VISUAL_THRESHOLD=0.70
AWS_RETRY_MAX_ATTEMPTS=3
AWS_RETRY_BASE_DELAY_MS=100
